# Copie este archivo a .env y rellene su clave. .env esta ignorado por Git.

# ---- Proveedor del modelo de lenguaje -------------------------------------
# gemini -> clave gratuita en https://aistudio.google.com/apikey
# groq   -> clave gratuita en https://console.groq.com
PROVEEDOR_LLM=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# El nombre del modelo cambia y se deprecan versiones. Compruebe cuales admite
# su clave con:  uv run asistente modelos
MODELO_LLM=gemini-2.5-flash
MAX_TOKENS=1024

# ---- Embeddings (locales, no consumen API) --------------------------------
MODELO_EMBEDDINGS=paraphrase-multilingual-MiniLM-L12-v2

# ---- Salario minimo usado para calcular multas ----------------------------
# El Codigo Nacional de Transito expresa las multas en SMLDV (salario minimo
# legal diario vigente), no en pesos. En 2026 la cifra esta en disputa: el
# Decreto 1469 de 2025 la fijo en 1.750.905, el Consejo de Estado suspendio
# provisionalmente sus efectos y el Decreto 0159 de 2026 la fijo de forma
# transitoria. Verifique el valor vigente antes de citar una multa.
SMLMV=1750905
FUENTE_SMLMV=Decreto 1469 de 2025 (suspendido provisionalmente; verifique el valor vigente)

# ---- Parametros de memoria (valores del tutorial) -------------------------
MAX_MENSAJES=10
MAX_CARACTERES=8000
DIAS_VIGENCIA=14
UMBRAL_DUPLICADO=0.15
K_HECHOS=5
EXTRAER_CADA=6

# ---- Parametros del RAG de documentos ------------------------------------
TAMANO_FRAGMENTO=1000
SOLAPE_FRAGMENTO=150
K_FRAGMENTOS=4
DISTANCIA_MAX_DOCUMENTOS=0.65
